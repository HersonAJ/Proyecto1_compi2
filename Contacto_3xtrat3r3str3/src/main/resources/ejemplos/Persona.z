public class TestArreglos {
    int[] numeros;

    public TestArreglos() {
        numeros = new int[5];
    }

    public void probarArreglo() {
        int[] locales = new int[3];
        locales[0] = 10;
        locales[1] = 20;
        locales[2] = 30;
        int suma = locales[0] + locales[1];
        numeros[0] = suma;
        println("Suma calculada");
    }
}